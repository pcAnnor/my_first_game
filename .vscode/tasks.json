{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: GCC (MSYS2 UCRT64)",
            "type": "process",
            "command": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": [
                "-lc",
                "gcc -g -Wall \"${fileBasename}\" -o \"${fileBasenameNoExtension}.exe\""
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "MSYSTEM": "UCRT64",
                    "CHERE_INVOKING": "1"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe 生成活动文件",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}